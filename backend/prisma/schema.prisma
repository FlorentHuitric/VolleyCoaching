// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  firstName   String
  lastName    String
  role        Role     @default(COACH)
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  teams       Team[]
  trainings   Training[]
  exercises   Exercise[]

  @@map("users")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  avatar      String?
  coachId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  coach       User       @relation(fields: [coachId], references: [id])
  players     Player[]
  trainings   Training[]
  tactics     Tactic[]

  @@map("teams")
}

model Player {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  jerseyNumber    Int
  position        Position
  avatar          String?
  teamId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  team            Team              @relation(fields: [teamId], references: [id])
  stats           PlayerStat[]
  trainingPlayers TrainingPlayer[]
  tacticPlayers   TacticPlayer[]
  assessments     PlayerAssessment[]

  @@unique([teamId, jerseyNumber])
  @@map("players")
}

model PlayerStat {
  id        String   @id @default(cuid())
  playerId  String
  statType  StatType
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player    Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, statType])
  @@map("player_stats")
}

model PlayerAssessment {
  id          String   @id @default(cuid())
  playerId    String
  strengths   String[] // Points forts
  weaknesses  String[] // Points faibles
  notes       String?
  overallRating Int    @default(0) // Note globale sur 100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  player      Player @relation(fields: [playerId], references: [id])

  @@map("player_assessments")
}

model Training {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int      // en minutes
  difficulty  Int      @default(1) // 1-5
  coachId     String
  teamId      String?
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  coach           User              @relation(fields: [coachId], references: [id])
  team            Team?             @relation(fields: [teamId], references: [id])
  exercises       TrainingExercise[]
  trainingPlayers TrainingPlayer[]

  @@map("trainings")
}

model TrainingPlayer {
  id         String @id @default(cuid())
  trainingId String
  playerId   String

  // Relations
  training   Training @relation(fields: [trainingId], references: [id])
  player     Player   @relation(fields: [playerId], references: [id])

  @@unique([trainingId, playerId])
  @@map("training_players")
}

model Exercise {
  id               String   @id @default(cuid())
  name             String
  description      String?
  videoUrl         String?
  instagramUrl     String?
  duration         Int      // en minutes
  difficulty       Int      @default(1) // 1-5
  minPlayers       Int      @default(1)
  maxPlayers       Int      @default(12)
  targetStats      StatType[] // Stats améliorées
  equipment        String[] // Matériel nécessaire
  reward           String?  // Contrat si réussite
  penalty          String?  // Malus si échec
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  createdBy        User               @relation(fields: [createdById], references: [id])
  trainingExercises TrainingExercise[]

  @@map("exercises")
}

model TrainingExercise {
  id         String @id @default(cuid())
  trainingId String
  exerciseId String
  order      Int    @default(0)

  // Relations
  training   Training @relation(fields: [trainingId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([trainingId, exerciseId])
  @@map("training_exercises")
}

model Tactic {
  id          String   @id @default(cuid())
  name        String
  description String?
  teamId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  team        Team           @relation(fields: [teamId], references: [id])
  phases      TacticPhase[]

  @@map("tactics")
}

model TacticPhase {
  id          String   @id @default(cuid())
  tacticId    String
  name        String
  order       Int      @default(0)
  duration    Int?     // en secondes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tactic      Tactic         @relation(fields: [tacticId], references: [id])
  players     TacticPlayer[]
  movements   PlayerMovement[]

  @@map("tactic_phases")
}

model TacticPlayer {
  id        String @id @default(cuid())
  phaseId   String
  playerId  String
  startX    Float  @default(0)
  startY    Float  @default(0)

  // Relations
  phase     TacticPhase @relation(fields: [phaseId], references: [id])
  player    Player      @relation(fields: [playerId], references: [id])

  @@unique([phaseId, playerId])
  @@map("tactic_players")
}

model PlayerMovement {
  id        String @id @default(cuid())
  phaseId   String
  playerId  String
  fromX     Float
  fromY     Float
  toX       Float
  toY       Float
  timestamp Int    @default(0) // en millisecondes depuis le début de la phase

  // Relations
  phase     TacticPhase @relation(fields: [phaseId], references: [id])

  @@map("player_movements")
}

enum Role {
  COACH
  ASSISTANT_COACH
  PLAYER
  ADMIN
}

enum Position {
  SETTER         // Passeur
  OUTSIDE_HITTER // Attaquant de pointe
  MIDDLE_BLOCKER // Central
  OPPOSITE       // Attaquant diagonal
  LIBERO         // Libéro
  DEFENSIVE_SPECIALIST // Spécialiste défensif
}

enum StatType {
  SERVE_ACCURACY      // Précision du service
  SPIKE_POWER         // Puissance d'attaque
  BLOCKING_HEIGHT     // Hauteur de contre
  RECEPTION_QUALITY   // Qualité de réception
  SETTING_ACCURACY    // Précision de passe
  DIGGING_SKILL       // Compétence en défense
  ENDURANCE          // Endurance
  AGILITY            // Agilité
  JUMPING_HEIGHT     // Hauteur de saut
  REACTION_TIME      // Temps de réaction
}